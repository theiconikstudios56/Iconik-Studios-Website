{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/content-version.json",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "https://rmd.theiconikstudios.com"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store"
                }
            ]
        }
    ]
}
