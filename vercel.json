{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/blog/:slug",
            "destination": "/api/blog-page?slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/app.html"
        }
    ],
    "headers": [
        {
            "source": "/content-version.json",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "https://rmd.theiconikstudios.com"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store"
                }
            ]
        },
        {
            "source": "/fonts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
